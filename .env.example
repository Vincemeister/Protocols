# Copy to .env.local. With the Supabase values empty the app still runs:
# pages render, and sign-in says it isn't connected.

# Supabase project "favolist" (Singapore): the project URL and the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, for seed scripts. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Voice reviews (phase 3), server only. Without a key the review screen still
# works: the browser's own live transcript is used where it has one, and
# typing always works.
OPENAI_API_KEY=
# Optional. The transcription model (default: gpt-transcribe).
OPENAI_TRANSCRIBE_MODEL=
# Optional. Set a chat model here to let a language model do the tidy pass
# (its output is checked word by word). Unset = the rule-based tidy pass.
OPENAI_TIDY_MODEL=

# Optional. The site's own address once a domain is connected, e.g. favolist.com
# (no https://). Used where the copy names the address.
NEXT_PUBLIC_SITE_HOST=
