# Copy to .env.local. With the Supabase values empty the app still runs:
# pages render, and sign-in says it isn't connected.

# Supabase project "favolist" (Singapore): the project URL and the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, for seed scripts. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
